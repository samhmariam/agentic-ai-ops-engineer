# The repo-root .gitignore excludes every data/ directory; this project ships its
# CRM dataset, so re-include it here.
!data/

# Secrets
.env
.env.*
!.env.example

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Scratch output from evaluation runs (eval writes emails here, not to data/)
reports/eval_outbox_*.json

# Output-guardrail review queue: withheld responses may contain restricted content
review/*.jsonl
reports/eval_review_queue_*.jsonl
reports/eval_approvals_*.jsonl

# Generated run artifacts: one trace per agent run, an append-only log, and
# timestamped eval/report/compare files per evaluation. They stay on disk for local
# use (salesops-agent compare, reports) but are not committed. A curated set is
# committed instead: traces/examples/, logs/examples/, reports/results/,
# reports/comparisons/ and reports/evaluation_report.*
traces/*.json
logs/*.jsonl
reports/eval_*.json
reports/report_*.md
reports/compare_*.md

# Emails "sent" by approved send_email calls
outbox/*.json
