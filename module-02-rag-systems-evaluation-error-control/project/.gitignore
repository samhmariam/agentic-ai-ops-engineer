# Local secrets (.env.example is tracked as the template)
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Local on-disk data stores written by the starter at runtime
data/chroma/
data/phoenix/
data/cost_log.jsonl

# Runtime inbox — file-watcher input + quarantine. Keep the directory
# (via .gitkeep) but ignore any fixtures dropped in during dry runs.
data/inbox/*.json
data/inbox/failed/

# Operator runtime artifacts from `make harvest-evidence`
WRITEUP-draft.md
WRITEUP-evidence/

# OS-level
.DS_Store

# Local Claude state
.claude/
