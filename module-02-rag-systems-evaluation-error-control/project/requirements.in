# requirements.in — direct dependencies only (constraints, not pins)
#
# This file mirrors the top-level `dependencies` and `dependency-groups.dev`
# sections of pyproject.toml — same version ranges, no transitive deps.
# Useful when the Udacity tech team needs to re-resolve transitive
# versions (e.g., for a CVE patch) without re-deriving the constraints
# by hand from pyproject.toml.
#
# To re-resolve a fresh pinned `requirements.txt` from this file:
#   pip install pip-tools
#   pip-compile --output-file=requirements.txt requirements.in
#
# Or just use uv:
#   uv export --no-hashes --no-emit-project --all-groups > requirements.txt

